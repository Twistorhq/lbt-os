{"$id":"twistor://data-layer/schemas/benchmarks/v1","$schema":"http://json-schema.org/draft-07/schema#","description":"Contract for one org's 30d metric snapshot. The promotion job validates every record against this before writing silver.","properties":{"cohort_key":{"description":"trade:region:shopsize, e.g. hvac:co:smb. Legacy trade:smb accepted.","pattern":"^[a-z_]+:[a-z0-9-]+(:[a-z]+)?$","type":"string"},"computed_at":{"format":"date-time","type":"string"},"metrics":{"items":{"properties":{"metric_name":{"enum":["leak_findings","dollars_at_stake","quote_close_rate","quote_resurrection_value","plan_churn_rate","equipment_replacement_pipeline","missed_call_recovery_rate","time_to_first_response_min","toll_spend_per_booked_job_cents","estimate_close_rate","avg_job_value_cents"],"type":"string"},"metric_value":{"type":"number"},"sample_size":{"minimum":0,"type":"integer"}},"required":["metric_name","metric_value"],"type":"object"},"minItems":1,"type":"array"},"org_id":{"description":"Internal org UUID. Org-private; never leaves silver.","type":"string"},"period":{"enum":["30d","90d"],"type":"string"}},"required":["org_id","cohort_key","period","computed_at","metrics"],"title":"Trades benchmark metric batch (byproduct, v1)","type":"object"}