# Fonoster self-host stack — environment template (TW-727).
# Copy to .env at go-live and fill in real values there.
# NEVER commit a filled .env. Prepared by Twistor Holdings LLC

# Fonoster platform release pin (re-verify tags at deploy time).
FONOSTER_IMAGE_TAG=v0.34.3

# Stack database (local to the compose network).
FONOSTER_DB_USER=fonoster
FONOSTER_DB_PASSWORD=
FONOSTER_DB_NAME=fonoster

# Backend (lbt-os) settings that point the TW-284 provider factories
# at this stack once it is deployed — set these in the backend's own
# environment, not here:
#   PHONE_PROVIDER=fonoster
#   FONOSTER_API_ENDPOINT=<host>:50051
#   FONOSTER_ACCESS_KEY_ID=<workspace access key id>
#   FONOSTER_ACCESS_KEY_SECRET=<workspace access key secret>
#   FONOSTER_FROM_NUMBER=<shop number on the SIP trunk>
#   FONOSTER_AUTOPILOT_APP_REF=<ref printed by applications:create>
#
# Hear/Speak provider keys (Deepgram by default) are configured as
# Fonoster workspace integrations at go-live — they do not belong in
# this file or in the agent YAML.
